{
  "manifest_version": 3,
  "name": "InterviewPrep",
  "version": "0.1.0",
  "description": "Offline-first technical interview preparation for developers.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "InterviewPrep",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["tabs"],
  "host_permissions": ["https://raw.githubusercontent.com/*"]
}
